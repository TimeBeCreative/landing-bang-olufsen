section#about.about
  picture.about__media
    source(
      type='image/avif',
      srcset='/src/assets/images/about-banner-400.avif 400w, /src/assets/images/about-banner-800.avif 800w',
      sizes='100vw'
    )
    source(
      type='image/webp',
      srcset='/src/assets/images/about-banner-400.webp 400w, /src/assets/images/about-banner-800.webp 800w',
      sizes='100vw'
    )
    img.about__img(
      src='/src/assets/images/about-banner-800.jpg',
      alt='Bang & Olufsen Beosound 9000c turntable and speaker',
      width='1260',
      height='460',
      loading='lazy',
      decoding='async'
    )

  .about__body
    .l-container
      .l-grid
        h2.section-title.about__title= siteData.about.title
        p.about__text= siteData.about.text
