section#recommended.recommended
  .l-container
    h2.section-title.recommended__title Recommended

    .l-grid.recommended__list
      each item in siteData.recommended
        article.product-card.recommended__item
          .product-card__media
            picture
              source(
                type='image/avif',
                srcset=`/src/assets/images/${item.image}-400.avif 400w, /src/assets/images/${item.image}-800.avif 800w`,
                sizes='(min-width: 1260px) 324px, (min-width: 744px) 600px, 280px'
              )
              source(
                type='image/webp',
                srcset=`/src/assets/images/${item.image}-400.webp 400w, /src/assets/images/${item.image}-800.webp 800w`,
                sizes='(min-width: 1260px) 324px, (min-width: 744px) 600px, 280px'
              )
              img.product-card__img(
                src=`/src/assets/images/${item.image}-800.jpg`,
                alt=item.alt,
                width='324',
                height='324',
                loading='lazy',
                decoding='async'
              )

          h3.product-card__title= item.title
          p.product-card__description= item.description
          p.product-card__price= item.price
